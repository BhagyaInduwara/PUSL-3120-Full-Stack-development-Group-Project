# FlowERP — environment variables (Supabase, V1)
#
# Copy this file to `.env` (or `.env.local`) and fill in the real values from
# your Supabase project dashboard. Never commit the filled-in file — `.env*`
# is gitignored except for this `.env.example` template. See CLAUDE.md
# "Database (Supabase, V1)" for how these map to the repository layer.
#
# Where to find every value: Supabase dashboard → your project. Supabase's
# newer dashboard splits these across two places — there's no single
# "Database" settings page anymore:
#   - API URL/keys → Project Settings (gear icon) → "API Keys" (keys) and
#     "Data API" (project URL), both under the Integrations section.
#   - Postgres connection strings → NOT under Project Settings at all —
#     click the green "Connect" button in the top bar of the project
#     (next to the branch selector), which opens a "Connect to your
#     project" dialog with a Direct connection / Transaction pooler /
#     Session pooler picker.
#   - AUTH_SECRET below is NOT from Supabase at all — see its own comment.

# ---------------------------------------------------------------------------
# App auth (src/server/auth/) — Express Backend Session Verification
# ---------------------------------------------------------------------------

# Secret key used to verify session tokens issued by the Express backend.
# Copy the exact same value from your server/.env JWT_SECRET:
JWT_SECRET=YOUR_BACKEND_JWT_SECRET

# URL where the Express backend runs — used by Next.js Server
# Components/Route Handlers (server-to-server, never reaches the browser).
BACKEND_URL=http://localhost:4000

# Same URL, but for client-side ("use client") pages' own fetch() calls —
# these run in the visitor's browser, so this needs the NEXT_PUBLIC_
# prefix to be embedded into the bundle at build time. Locally this
# defaults to localhost:4000 if unset, so it's only required in
# production: on Vercel, set this to wherever /server is actually
# deployed (e.g. a Render URL) — without it, every client-side page tries
# to reach the *visitor's own machine* on port 4000 and fails with
# "Could not reach backend server."
NEXT_PUBLIC_API_URL=http://localhost:4000


# ---------------------------------------------------------------------------
# Data API (Project Settings → Data API / API Keys)
# ---------------------------------------------------------------------------

# "Project URL" on the Data API page — the bare origin, no trailing path
# (do NOT append /rest/v1/ — the client library adds that itself). Safe to
# expose to the browser (hence the NEXT_PUBLIC_ prefix) — it's just the
# base URL, not a secret.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# "anon" / "public" key, on the API Keys page. Also safe for the browser:
# it's the key Supabase's Row Level Security policies are designed to be
# handed to untrusted clients. Used by any repository code that runs in
# the browser or in a Next.js Server Component/Route Handler on the user's
# behalf.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# "service_role" / "secret" key, same page. Bypasses Row Level Security
# entirely — NEVER prefix this with NEXT_PUBLIC_, never send it to the
# browser, never log it. Only for trusted server-side code (e.g. a future
# SqlOrderRepository running in a Route Handler/Server Action that needs
# unrestricted access, or the seed scripts).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET_KEY

# ---------------------------------------------------------------------------
# Direct Postgres connection (top-bar "Connect" button → Connection string)
# ---------------------------------------------------------------------------
# Only needed if a repository implementation talks to Postgres directly
# (e.g. via `pg`, Drizzle, or Prisma) instead of the supabase-js client.
# Supabase gives you three connection modes in that dialog — grab whichever
# the tooling you pick expects, or set both of these:

# "Transaction pooler" option, port 6543 — use this for serverless/edge
# (Vercel, etc.) where connections are short-lived. Note this defaults to
# routing over IPv6 too (Supabase will offer a paid IPv4 add-on if your
# network/host needs IPv4) — the "Session pooler" option is the one
# Supabase recommends specifically for IPv4-only networks, as an
# alternative to this. Left blank below on purpose — a filled-in example
# (even with placeholder words) matches secret scanners' "looks like a
# connection string" pattern and gets auto-flagged as a leaked credential.
DATABASE_URL=

# "Direct connection" option, port 5432 — use this for long-lived processes
# (a local script, a traditional server) or for running the SQL files below
# via `psql`. Uses IPv6 by default, same caveat as above.
DIRECT_DATABASE_URL=
