# FlowERP backend (Express + Mongoose) — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored
# (the root .gitignore's `.env*` pattern covers this folder too).

# MongoDB Atlas connection string: dashboard → Database → Connect → Drivers.
# Replace <user>/<password> and add a database name before the query string, e.g.:
#   mongodb+srv://flowerp:REALPASSWORD@cluster0.xxxxx.mongodb.net/flowerp?retryWrites=true&w=majority
#
# If `npm run seed` or `npm run dev` fails with `querySrv ECONNREFUSED`,
# it's not your credentials — Node's DNS resolution for the +srv format
# fails on some networks (mobile hotspots especially) even though the
# network is otherwise fine. Fix: use the standard (non-SRV) connection
# string instead. Get the two extra pieces you need via:
#   nslookup -type=SRV _mongodb._tcp.<your-cluster-host> 8.8.8.8   (shard hostnames)
#   nslookup -type=TXT <your-cluster-host> 8.8.8.8                 (replicaSet/authSource)
# then build: mongodb://user:pass@host1:27017,host2:27017,host3:27017/flowerp?ssl=true&replicaSet=REPLICASET_NAME&authSource=admin&retryWrites=true&w=majority
# See CLAUDE.md "Backend (Express + Mongoose)" for the full story.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/flowerp?retryWrites=true&w=majority

# Signs JWTs. Generate your own, never share it, never commit a real one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=GENERATE_YOUR_OWN_RANDOM_SECRET

# Port this Express server listens on.
PORT=4000

# Origin the Next.js frontend runs on — CORS only allows requests from here
# (with credentials, since auth uses an httpOnly cookie, not a header).
CLIENT_ORIGIN=http://localhost:3000
